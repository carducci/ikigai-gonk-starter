guide:commit-notation a harness:Guide ;
    rdfs:label "commit in Arlo's Commit Notation" ;
    rdfs:comment "Every commit's first line starts `<risk> <intention> ` then the summary: risk from what you actually verified (`.` proven safe, `^` validated, `!` risky, `@` broken), exactly one intention per commit (uppercase changes behaviour, lowercase changes none), and microcommits." ;
    harness:statedIn "AGENTS.md" ; harness:section "Commit in Arlo's Commit Notation" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:maintainability .
